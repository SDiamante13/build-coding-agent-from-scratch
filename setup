#!/bin/sh
# One-time setup after cloning. Run it with: ./setup
# It checks for the tools you need, installs dependencies, gets your OpenRouter key into .env,
# then proves the model can actually call a tool - the failure that otherwise waits until lesson 4.
#
# With --check, it only reports what's missing instead of installing or prompting -
# for a coding agent (or CI) to run to verify things are ready, without risking a hang on input.
set -e
cd "$(dirname "$0")"
check_only=false
[ "$1" = "--check" ] && check_only=true

pass() { printf 'pass  %s\n' "$1"; }
fail() { printf 'FAIL  %s\n\n      %s\n' "$1" "$2"; exit 1; }

command -v node >/dev/null 2>&1 || fail "Node is not installed" \
  "Install Node 24 LTS from https://nodejs.org, then open a new terminal and run ./setup again."

# The lines every lesson's acceptance test has been run on, read straight from package.json
# "engines" so this never drifts out of step with it.
known_majors=$(node -p "require('./package.json').engines.node.split('||').map(s => s.trim().match(/\d+/)[0]).join(' ')")
known_majors_prose=$(echo "$known_majors" | sed 's/ /, /g' | sed 's/, \([0-9]*\)$/ or \1/')
major=$(node -p 'process.versions.node.split(".")[0]')
case " $known_majors " in
  *" $major "*) pass "Node $(node -v)" ;;
  *) fail "Node $(node -v) is not a version this workshop has been tested on" \
    "Use Node $known_majors_prose. Node 24 LTS is at https://nodejs.org; with nvm or fnm, run 'nvm use' here." ;;
esac

command -v git >/dev/null 2>&1 && pass "git $(git --version | cut -d' ' -f3)" \
  || fail "git is not installed" "Install it from https://git-scm.com and open a new terminal."

if [ -d node_modules ]; then
  pass "Dependencies installed"
elif $check_only; then
  fail "Dependencies are not installed" "Run: ./setup"
else
  printf 'pass  installing dependencies...\n'
  npm install --silent
  pass "Dependencies installed"
fi

if grep -q '^OPENROUTER_API_KEY=sk-' .env 2>/dev/null; then
  pass "OpenRouter key present"
elif $check_only; then
  fail "No OpenRouter key in .env" "Run ./setup in your terminal to paste one in."
else
  npx tsx scripts/set-key.ts
fi

grep -q '^OPENROUTER_MODEL=.' .env && pass "Model: $(sed -n 's/^OPENROUTER_MODEL=//p' .env)" \
  || fail "No model in .env" "Set OPENROUTER_MODEL in .env — .env.example has the default."

# Node's --env-file never overrides a variable the shell already exports, so a stale key in a
# shell profile silently wins over .env — for the agent, and for the check below.
for name in OPENROUTER_API_KEY OPENROUTER_MODEL; do
  eval "exported=\${$name:-}"
  [ -n "$exported" ] && [ "$exported" != "$(sed -n "s/^$name=//p" .env)" ] \
    && fail "Your shell exports a different $name than .env sets" \
      "The agent will use the shell's. Run: unset $name — or remove it from your shell profile."
done

# The check that matters: a model that chats fine can still be unable to emit a tool call, and
# that only surfaces in lesson 4. So ask it to use a tool and see whether it does.
node --env-file=.env --input-type=module <<'JS' || exit 1
const model = process.env.OPENROUTER_MODEL;
const response = await fetch('https://openrouter.ai/api/v1/chat/completions', {
  method: 'POST',
  headers: { Authorization: `Bearer ${process.env.OPENROUTER_API_KEY}`, 'Content-Type': 'application/json' },
  body: JSON.stringify({
    model,
    messages: [{ role: 'user', content: 'Read the file package.json' }],
    tools: [{ type: 'function', function: {
      name: 'read_file',
      description: 'Read a file from disk',
      parameters: { type: 'object', properties: { path: { type: 'string' } }, required: ['path'] },
    } }],
  }),
});

const fail = (what, fix) => { console.log(`FAIL  ${what}\n\n      ${fix}`); process.exit(1); };
const body = await response.json().catch(() => ({}));
const message = body.error?.message ?? '';
const status = body.error?.code ?? response.status;

if (status === 401) fail('OpenRouter rejected the key', 'Check OPENROUTER_API_KEY in .env — the key is wrong or not yet active.');
if (status === 429) fail(`${model} is rate limited by its provider`, 'Only switching models clears that. Set OPENROUTER_MODEL=openai/gpt-5.6-luna in .env — it costs cents.');
if (body.error || !response.ok) fail(`${model} returned ${status}`, message || 'Try again, or switch OPENROUTER_MODEL in .env.');

const choice = body.choices?.[0];
if (choice?.finish_reason !== 'tool_calls' && !choice?.message?.tool_calls?.length) {
  fail(`${model} answered with text instead of calling the tool`, 'It will not carry the workshop. Set OPENROUTER_MODEL=openai/gpt-5.6-luna in .env.');
}

console.log(`pass  ${model} calls tools`);
JS

echo
echo "You're set up. Say \"coach me\" to start lesson 2."
