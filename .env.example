# Run ./setup and it does this for you: copies this file to .env, then prompts for your key.
# .env is gitignored — your key never leaves your machine.

# Get one at https://openrouter.ai/keys
OPENROUTER_API_KEY=

# Any model that supports tool calling works. This one is the cheapest that does — a whole
# workshop costs a few cents. If it starts arguing with you, try openai/gpt-5.6-luna.
# Not google/gemini-3.7-flash: it breaks in lesson 10. See the README.
# Browse the rest at https://openrouter.ai/models?order=coding-high-to-low
OPENROUTER_MODEL=deepseek/deepseek-v4-flash-0731
