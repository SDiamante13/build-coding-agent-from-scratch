# Copy this file to .env, then fill in your key:
#
#     cp .env.example .env
#
# .env is gitignored — your key never leaves your machine.

# Get one at https://openrouter.ai/keys
OPENROUTER_API_KEY=

# Any model that supports tool calling works. This one is free.
# Browse the rest at https://openrouter.ai/models?order=coding-high-to-low
OPENROUTER_MODEL=z-ai/glm-5.2:free
