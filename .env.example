# Copy this file to .env, then fill in your key:
#
#     cp .env.example .env
#
# .env is gitignored — your key never leaves your machine.

# Get one at https://openrouter.ai/keys
OPENROUTER_API_KEY=

# Any model that supports tool calling works. This one is free, and rate limited —
# if replies start failing, add credit and try openai/gpt-5.6-luna instead.
# Not google/gemini-3.7-flash: it breaks in lesson 10. See the README.
# Browse the rest at https://openrouter.ai/models?order=coding-high-to-low
OPENROUTER_MODEL=minimax/minimax-m3:free
